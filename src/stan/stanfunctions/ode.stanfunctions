/**
 * @brief Differential equation of hunting vs time
 *
 * Used to determine the number of hunted seals
 *
 * @param tau time
 * @param H expected number of hunted seals
 * @param n0 initial population size
 * @param k length of hunting season
 * @param E_1 hunting effort in region 1
 * @param E_2 hunting effort in region 2
 * @param mu other mortality rate
 * @return Description of return value
*/
vector dH_dt(
    real tau,
    vector H,
    real n0,
    real k,
    real E_1,
    real E_2,
    real mu
  ) {

    real surv = exp(-(E_1 + E_2) * (k * tau - square(tau) / 2) - mu * tau);
    real dH = n0 * E_1 * surv * (k - tau);
    return rep_vector(dH, 1);
  }

/**
 * @brief Calculate expected hunting pressure
 *
 * Used to calculate the hunting pressure
 *
 * @param Q Hunting quota
 * @param epsilon_h
 * @param sigma_h
 * @param tau_h
 * @param g
 * @param N
 * @return Description of return value
*/
vector expected_hunting_pressure(
  int Q,
  real epsilon_h,
  real sigma_h,
  real tau_h,
  vector g,
  vector N
) {
  int K = size(g);

  // log numerator
  vector[K] log_num =
      g
    + log(Q)
    + log(2.0)
    - 2.0 * log(tau_h)
    - epsilon_h * sigma_h;

  // log denominator
  real log_denom = log_sum_exp(g + log(N));

  // final result
  return exp(log_num - log_denom);
}
