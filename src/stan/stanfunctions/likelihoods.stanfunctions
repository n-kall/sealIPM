real bycatch_comp_lpmf(
  array[,] int bycatch_composition,   // [n_obs, K]
  array[] int bycatch_comp_year,      // [n_obs]
  matrix bycatch_expected,            // [K, T]
  vector bias                          // [K]
) {
  int n_obs = size(bycatch_composition);
  vector[rows(bycatch_expected)] w = exp(bias);
  real lp = 0;

  for (i in 1:n_obs) {
    int t = bycatch_comp_year[i];
    lp += multinomial_lpmf(
      bycatch_composition[i] |
      (w .* bycatch_expected[, t]) /
        dot_product(w, bycatch_expected[, t])
    );
  }
  return lp;
}


