array[] real harvest_bags_rng(
  array[] int hunting_year,
  vector hunted_total,
  real harvest_bag_cv
) {
  int n_obs = size(hunting_year);
  array[n_obs] real y_sim;

  for (i in 1:n_obs) {
    int t = hunting_year[i];
    if (hunted_total[t] > 0) {
      y_sim[i] = normal_rng(
        hunted_total[t],
        harvest_bag_cv * hunted_total[t]
      );
    } else {
      y_sim[i] = 0.0;
    }
  }

  return y_sim;
}


array[,] int hunting_comp_rng(
  array[] int hunting_year,
  matrix hunted,
  vector hunted_total,
  array[] int hunting_sample_size
) {
  int n_obs = size(hunting_year);
  int K = rows(hunted);
  array[n_obs, K] int y_sim;

  for (i in 1:n_obs) {
    int t = hunting_year[i];
    if (hunting_sample_size[i] == 0 || hunted_total[t] <= 0) {
      y_sim[i] = rep_array(0, K);
    } else {
      y_sim[i] = multinomial_rng(
        hunted[, t] / hunted_total[t],
        hunting_sample_size[i]
      );
    }
  }

  return y_sim;
}


array[,] int bycatch_comp_rng(
  array[] int bycatch_comp_year,
  matrix bycatch_expected,
  vector bias,
  array[] int bycatch_sample_size
) {
  int n_obs = size(bycatch_comp_year);
  int K = rows(bycatch_expected);
  vector[K] w = exp(bias);
  array[n_obs, K] int y_sim;

  for (i in 1:n_obs) {
    int t = bycatch_comp_year[i];
    real denom = dot_product(w, bycatch_expected[, t]);

    if (bycatch_sample_size[i] == 0 || denom <= 0) {
      y_sim[i] = rep_array(0, K);
    } else {
      y_sim[i] = multinomial_rng(
        (w .* bycatch_expected[, t]) / denom,
        bycatch_sample_size[i]
      );
    }
  }

  return y_sim;
}


