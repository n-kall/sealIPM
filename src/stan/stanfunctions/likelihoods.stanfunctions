real hunting_comp_lpmf(
  array[,] int hunting_composition,  // [n_obs, K]
  array[] int hunting_year,          // [n_obs]
  matrix hunted,                      // [K, T]
  vector hunted_total           // [T]
) {
  int n_obs = size(hunting_composition);
  real lp = 0;

  for (i in 1:n_obs) {
    int t = hunting_year[i];
      lp += multinomial_lpmf(
        hunting_composition[i] |
        hunted[, t] / hunted_total[t]
      );
  }

  return lp;
}

