/**
 * @file
 * @brief Continuous and discrete ageing and newborn population updates
 */

/**
 * @brief Create the female and male ageing matrix.
 *
 *
 * @param n_demo_groups Number of demographic groups
 * @param n_age_groups Number of age groups
 * @return aging matrix
 */
matrix create_aging_matrix(
  data int n_demo_groups,
  data int n_age_groups
) {
  matrix[n_demo_groups, n_demo_groups] A =
    rep_matrix(0.0, n_demo_groups, n_demo_groups);

  for (i in 2:n_age_groups) {
    A[i, i - 1] = 1.0;
  }
  A[n_age_groups, n_age_groups] = 1.0;

  for (i in (n_age_groups + 2):n_demo_groups) {
    A[i, i - 1] = 1.0;
  }
  A[n_demo_groups, n_demo_groups] = 1.0;

  return A;
}

/**
 * @brief update_population_from_survivors
 *
 * Advance the continuous population and add stochastic births.
 *
 * @param previous_survivors vector of previous survivors in each demo group
 * @param aging_mat aging matrix
 * @param birth_rate birth rate
 * @param birth_count_noise Standardized deviation in the number of pups born
 * @param pup_sex_allocation_noise Standardized deviation in the female and male pup allocation
 * @param n_age_classes number of age classes
 * @return vector of new population
 */
vector update_population_from_survivors(
  vector previous_survivors,
  data matrix aging_mat,
  real birth_rate,
  real birth_count_noise,
  real pup_sex_allocation_noise,
  data int n_age_classes
) {
  int n_demo = rows(previous_survivors);
  vector[n_demo] N = aging_mat * previous_survivors;
  real N_temp;

  N_temp =
    N[n_age_classes] * birth_rate
    + sqrt(
        N[n_age_classes]
        * birth_rate
        * (1.0 - birth_rate)
      ) * birth_count_noise;

  N[1] =
    N_temp / 2.0
    + sqrt(N_temp / 4.0) * pup_sex_allocation_noise;

  N[n_age_classes + 1] =
    N_temp - N[1];

  return N;
}

/**
 * @brief Age integer survivors and simulate newborns.
 *
 * Female groups occupy indices `1:n_age_classes`; male groups occupy
 * `(n_age_classes + 1):(2 * n_age_classes)`. The final group for each sex is
 * a plus group. Births and newborn sex allocation use binomial draws.
 *
 * @param previous_survivors Integer survivors from the preceding year.
 * @param birth_rate Probability that an adult female gives birth.
 * @param n_age_classes Number of age classes for each sex.
 * @return Integer population composition for the new year.
 */
array[] int update_population_from_survivors_rng(
  array[] int previous_survivors,
  real birth_rate,
  data int n_age_classes
) {
  int n_demo_groups = 2 * n_age_classes;
  array[n_demo_groups] int population = rep_array(0, n_demo_groups);
  int adult_females;
  int newborns;
  int female_newborns;

  if (size(previous_survivors) != n_demo_groups) {
    reject(
      "update_population_from_survivors_rng expected ",
      n_demo_groups,
      " demographic groups, received ",
      size(previous_survivors)
    );
  }

  if (!(birth_rate >= 0.0 && birth_rate <= 1.0)) {
    reject(
      "update_population_from_survivors_rng requires birth_rate in [0, 1]; ",
      "birth_rate=", birth_rate
    );
  }

  if (n_age_classes < 2) {
    reject(
      "update_population_from_survivors_rng requires at least two age ",
      "classes; n_age_classes=", n_age_classes
    );
  }

  if (n_age_classes > 2) {
    for (age in 2:(n_age_classes - 1)) {
      population[age] = previous_survivors[age - 1];
      population[n_age_classes + age] =
        previous_survivors[n_age_classes + age - 1];
    }
  }

  population[n_age_classes] =
    previous_survivors[n_age_classes - 1]
    + previous_survivors[n_age_classes];

  population[2 * n_age_classes] =
    previous_survivors[2 * n_age_classes - 1]
    + previous_survivors[2 * n_age_classes];

  adult_females = population[n_age_classes];
  newborns = binomial_rng(adult_females, birth_rate);
  female_newborns = binomial_rng(newborns, 0.5);

  population[1] = female_newborns;
  population[n_age_classes + 1] = newborns - female_newborns;

  return population;
}
