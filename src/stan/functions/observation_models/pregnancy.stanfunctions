/**
 * @brief pregnancy_lpmf
 *
 * @param pregnancy_count Observed counts of pregnancy signs
 * @param pregnancy_count_year Which years are the counts from
 * @param pregnancy_sample_size Sample sizes for the survey
 * @param pregnancy_rate Pregnancy rate
 * @return log probability mass based on binomial model
 */
real pregnancy_lpmf(
  array[] int pregnancy_count,
  array[] int pregnancy_count_year,
  array[] int pregnancy_sample_size,
  vector pregnancy_rate
) {
  int n_obs = size(pregnancy_count);
  real lp = 0;

  for (i in 1:n_obs) {
    int t = pregnancy_count_year[i];
    lp += binomial_lpmf(
      pregnancy_count[i] |
      pregnancy_sample_size[i],
      pregnancy_rate[t]
    );
  }

  return lp;
}

/**
 * @brief pregnancy_pointwise_log_lik
 *
 *
 * @param pregnancy_count Observed counts of pregnancy signs
 * @param pregnancy_count_year Which years are the counts from
 * @param pregnancy_sample_size Sample sizes for the survey
 * @param pregnancy_rate Pregnancy rate
 * @return vector of log-likelihood values for each year
 */
vector pregnancy_pointwise_log_lik(
  array[] int pregnancy_count,
  array[] int pregnancy_count_year,
  array[] int pregnancy_sample_size,
  vector pregnancy_rate
) {
  int n_obs = size(pregnancy_count);
  vector[n_obs] log_lik;

  for (i in 1:n_obs) {
    int t = pregnancy_count_year[i];
    log_lik[i] = binomial_lpmf(
      pregnancy_count[i] |
      pregnancy_sample_size[i],
      pregnancy_rate[t]
    );
  }

  return log_lik;
}



/**
 * @brief pregnancy_rng
 *
 * @param pregnancy_count Observed counts of pregnancy signs
 * @param pregnancy_count_year Which years are the counts from
 * @param pregnancy_sample_size Sample sizes for the survey
 * @param pregnancy_rate Pregnancy rate
 * @return vector generated pregnancy observations for each year
 */
array[] int pregnancy_rng(
  array[] int pregnancy_count_year,
  array[] int pregnancy_sample_size,
  vector pregnancy_rate
) {
  int n_obs = size(pregnancy_count_year);
  array[n_obs] int y_sim;

  for (i in 1:n_obs) {
    int t = pregnancy_count_year[i];
    y_sim[i] = binomial_rng(
      pregnancy_sample_size[i],
      pregnancy_rate[t]
    );
  }

  return y_sim;
}
