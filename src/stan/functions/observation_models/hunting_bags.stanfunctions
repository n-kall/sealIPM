/**
 * @brief hunting_bags_lpdf
 *
 * @param hunting_count Observed count of reported hunted seals
 * @param hunting_year Years of data
 * @param hunted_total Total hunted
* @param hunting_bag_cv variation in hunting reports
* @return log probability density based on normal model
 */
real hunting_bags_lpdf(
  array[] real hunting_count,   // observed count
  array[] int hunting_year,   // year
  vector hunted_total,    // total
  real hunting_bag_cv
) {
  int n_obs = size(hunting_count);
  real lp = 0;

  for (i in 1:n_obs) {
    int t = hunting_year[i];
    lp += normal_lpdf(
      hunting_count[i] |
      hunted_total[t],
      hunting_bag_cv * hunted_total[t]
    );
  }

  return lp;
}

/**
 * @brief hunting_bags_pointwise_log_lik
 *
 * @param hunting_count Observed count of reported hunted seals
 * @param hunting_year Years of data
 * @param hunted_total Total hunted
 * @param hunting_bag_cv variation in hunting reports
 * @return pointwise log-likelihood
 */
vector hunting_bags_pointwise_log_lik(
  array[] real hunting_count,   // observed count
  array[] int hunting_year,   // year
  vector hunted_total,    // total
  real hunting_bag_cv
) {
  int n_obs = size(hunting_count);
  vector[n_obs] log_lik;

  for (i in 1:n_obs) {
    int t = hunting_year[i];
    log_lik[i] = normal_lpdf(
      hunting_count[i] |
      hunted_total[t],
      hunting_bag_cv * hunted_total[t]
    );
  }

  return log_lik;
}

/**
 * @brief hunting_bags_rng
 *
 * @param hunting_year Years of data
 * @param hunted_total Total hunted
 * @param hunting_bag_cv variation in hunting reports
 * @return simulated observations from normal model
*/
array[] real hunting_bags_rng(
  array[] int hunting_year,
  vector hunted_total,
  real hunting_bag_cv
) {
  int n_obs = size(hunting_year);
  array[n_obs] real y_sim;

  for (i in 1:n_obs) {
    int t = hunting_year[i];
    if (hunted_total[t] > 0) {
      y_sim[i] = normal_rng(
        hunted_total[t],
        hunting_bag_cv * hunted_total[t]
      );
    } else {
      y_sim[i] = 0.0;
    }
  }

  return y_sim;
}
