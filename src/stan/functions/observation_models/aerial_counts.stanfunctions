/**
 * @brief aerial_count_lpmf
 *
 * @param obs_aerial_count vector of observed aerial counts
 * @param aerial_year vector specifying which years the counts are from (relative to the start year of the process)
 * @param non_pup_population_total vector of population estimates per year excluding pups (ages 1+)
 * @param mu real mean observation probability
 * @param phi real overdispersion parameter
 * @return log probability mass based on negative binomial model
 */
real aerial_count_lpmf(
  array[] int obs_aerial_count, //
  array[] int aerial_year, // year
  vector non_pup_population_total, // N ages 1+
  real mu, // mean prob
  real phi // overdispersion
) {
  int n_obs = size(obs_aerial_count);
  real lp = 0;

  for (i in 1:n_obs) {
    int t = aerial_year[i];

    lp += neg_binomial_2_lpmf(
      obs_aerial_count[i] |
      mu * non_pup_population_total[t],
      phi
    );
  }

  return lp;
}

/**
 * @brief aerial_count_pointwise_log_lik
 *
 *
 * @param obs_aerial_count vector of observed aerial counts
 * @param aerial_year vector specifying which years the counts are from (relative to the start year of the process)
 * @param non_pup_population_total vector of population estimates per year excluding pups (ages 1+)
 * @param mu real mean observation probability
 * @param phi real overdispersion parameter
 * @return vector of log-likelihood values for each year
 */
vector aerial_count_pointwise_log_lik(
  array[] int obs_aerial_count, // observed count
  array[] int aerial_year, // year
  vector non_pup_population_total, // N ages 1+
  real mu, // mean prob
  real phi // overdispersion
) {
  int n_obs = size(obs_aerial_count);
  vector[n_obs] log_lik;

  for (i in 1:n_obs) {
    int t = aerial_year[i];

    log_lik[i] = neg_binomial_2_lpmf(
      obs_aerial_count[i] |
      mu * non_pup_population_total[t],
      phi
    );
  }

  return log_lik;
}

/**
 * @brief Simulate aerial survey counts.
 *
 * @param aerial_year vector specifying which years the counts are from (relative to the start year of the process)
 * @param non_pup_population_total vector of population estimates per year excluding pups (ages 1+)
 * @param mu real mean observation probability
 * @param phi real overdispersion parameter
 * @return vector of simulated aerial survey count for each year
 */
array[] int aerial_count_rng(
  array[] int aerial_year,
  vector non_pup_population_total,
  real mu,
  real phi
) {
  int n_obs = size(aerial_year);
  array[n_obs] int y_sim;

  for (i in 1:n_obs) {
    int t = aerial_year[i];
    real expected_count =
      mu * non_pup_population_total[t];

    if (expected_count == 0) {
      y_sim[i] = 0;
    } else {
      y_sim[i] =
        neg_binomial_2_rng(
          expected_count,
          phi
        );
    }
  }

  return y_sim;
}
